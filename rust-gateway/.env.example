# Transport mode: uds or mtls
TRANSPORT_MODE=uds

# Unix socket path (for uds mode)
SOCKET_PATH=/var/run/noise-gateway/noise.sock

# mTLS configuration (for mtls mode)
# LISTEN_ADDR=0.0.0.0:50051
# TLS_CA=/path/to/ca.pem
# TLS_CERT=/path/to/server.pem
# TLS_KEY=/path/to/server-key.pem

# Server configuration
HTTP_PORT=8443
GRPC_PORT=50051
SERVER_STATIC_KEY=YOUR_BASE64_ENCODED_32_BYTE_KEY

# Backend proxy configuration
BACKEND_URL=http://localhost:4000
PROXY_TIMEOUT=30

# Elixir gRPC backend (for device validation)
ELIXIR_GRPC_URL=http://localhost:50052

# Session configuration
SESSION_TTL=300
CLEANUP_INTERVAL=60
MAX_SESSIONS=1000000

# Logging
RUST_LOG=info
LOG_FORMAT=json
